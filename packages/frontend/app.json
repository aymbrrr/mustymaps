{
  "expo": {
    "name": "Musty's Map",
    "slug": "mustymaps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7FAF8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.calpoly.mustymaps",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Musty's Map uses your location to show where you are on campus. Your location is never stored."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7FAF8"
      },
      "package": "edu.calpoly.mustymaps",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-sqlite", "expo-location"]
  }
}
